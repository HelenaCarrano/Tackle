# Copie para .env e preencha. Tudo é opcional: sem nenhuma chave, as heurísticas locais já funcionam.

# Domínios da sua empresa (separados por vírgula). Ajuda a detectar quem imita vocês.
ORG_DOMAINS=suaempresa.com.br

# Senha de app do IMAP (Gmail: myaccount.google.com/apppasswords). Se vazio, o comando pergunta.
IMAP_PASSWORD=

# ---- Enriquecimento (só roda em e-mails com score local >= ENRICH_MIN_SCORE) ----
ENRICH_MIN_SCORE=25
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_PER_MINUTE=4          # conta gratuita: 4 consultas/minuto, 500/dia
DOMAIN_AGE_ENABLED=true          # consulta RDAP pública (sem chave)
EML_ANALYZER_URL=                # ex.: http://eml-analyzer:8000 (no docker compose, perfil "completo")
PHISHSAGE_ENABLED=false

# ---- IA ----
# Jev (TypeSafe AI): roda em TODOS os e-mails, é barato. Só soma pontos, nunca reduz.
JEV_ENABLED=false
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0             # versão fixa; teste antes de trocar

# LLM (Claude): escreve a explicação dos casos com score >= LLM_MIN_SCORE. Só soma pontos.
# Use UMA das chaves: Anthropic direto ou OpenRouter.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER=                    # anthropic | openrouter (vazio = usa a chave que existir)
LLM_MODEL=                       # vazio = claude-haiku-5-5 (Anthropic) ou anthropic/claude-haiku-5.5 (OpenRouter)
LLM_MIN_SCORE=15
